{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/renderer/**/*.ts", "src/app/api.ts", "src/core/graph.ts", "src/core/types.ts", "src/core/glossary.ts", "src/core/preview.ts"]
}
