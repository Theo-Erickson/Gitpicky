{
  "name": "gitpicky",
  "version": "0.1.0",
  "description": "See your git history as a picture, learn what every git word means, and preview changes before they happen. Includes an MCP server so an AI assistant can make repo changes you approve.",
  "author": "The Gitpicky contributors",
  "license": "MIT",
  "private": true,
  "main": "dist/app/main.js",
  "bin": {
    "gitpicky-mcp": "dist/mcp/gitpicky-mcp.js"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:renderer && npm run build:mcp",
    "build:node": "tsc -p tsconfig.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "start": "npm run build && electron .",
    "mcp": "node dist/mcp/gitpicky-mcp.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "readme:capture": "node tools/readme-media/capture.mjs",
    "readme:contact": "python tools/readme-media/build_media.py --sheet",
    "readme:build": "python tools/readme-media/build_media.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.18.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "desktopName": "gitpicky.desktop"
}
